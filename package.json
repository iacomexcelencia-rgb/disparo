{
  "name": "disparo-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "Campanhas de WhatsApp com contatos, listas, Workspace e histórico local",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm test && npm run build",
    "pack": "npm run build && electron-builder --win portable --x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node tests/workspace-ui-smoke.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "source:check": "node scripts/source-files.mjs",
    "source:export": "node scripts/export-source.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.12.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "https://github.com/wwebjs/whatsapp-web.js/archive/064a3d5a5a3dce1281a6a12740b5a7051339d154.tar.gz",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^8.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "puppeteer": "25.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "puppeteer": "25.16.0",
    "basic-ftp": "^6.2.3",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "br.com.disparo.desktop",
    "productName": "Disparo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/puppeteer*/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Disparo-${version}-Windows.exe"
    }
  },
  "license": "MIT",
  "author": "Samuel",
  "keywords": [
    "whatsapp",
    "desktop",
    "campanhas",
    "kanban",
    "electron"
  ]
}
